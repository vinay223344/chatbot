@prefix rvr: <http://example.org/rvrcollege/faculty#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# -----------------
# Schema Definitions
# -----------------

rvr:FacultyMember a owl:Class ;
    owl:equivalentClass foaf:Person .
rvr:GuidanceRecord a owl:Class .

# Define object properties (relationships)
rvr:hasGuidanceRecord a owl:ObjectProperty ;
    rvr:domain foaf:Person ;
    rvr:range rvr:GuidanceRecord .
rvr:guidanceFor a owl:ObjectProperty ;
    rvr:domain rvr:GuidanceRecord ;
    rvr:range foaf:Person .

# Define datatype properties (attributes)
rvr:hasName a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:hasDesignation a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:hasQualifications a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:dateOfJoining a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:date .
rvr:totalExperience a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:areaOfSpecialization a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:hasResearchInterests a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:totalPublications a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:journalPublications a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:conferencePublications a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:patentsCount a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:hIndexScopus a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:hIndexWebOfScience a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:hIndexGoogleScholar a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:citationScopus a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:citationWebOfScience a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:citationGoogleScholar a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:integer .
rvr:hasProfessionalMembership a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:hasCellNumber a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:long .
rvr:hasEmail a owl:DatatypeProperty ; rvr:domain foaf:Person ; rvr:range xsd:string .
rvr:phdAwarded a owl:DatatypeProperty ; rvr:domain rvr:GuidanceRecord ; rvr:range xsd:integer .
rvr:phdOngoing a owl:DatatypeProperty ; rvr:domain rvr:GuidanceRecord ; rvr:range xsd:integer .
rvr:mastersGuided a owl:DatatypeProperty ; rvr:domain rvr:GuidanceRecord ; rvr:range xsd:integer .
rvr:graduatesGuided a owl:DatatypeProperty ; rvr:domain rvr:GuidanceRecord ; rvr:range xsd:integer .

